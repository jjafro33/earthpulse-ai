# =========================================================
# EarthPulse AI — Environment Variables
# =========================================================
# FRONTEND (safe to expose in the browser — set in js/supabase.js
# or inject at build time). These are PUBLIC/publishable values.
# -----------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-PUBLISHABLE-ANON-KEY

# =========================================================
# BACKEND ONLY — set these as Supabase Edge Function secrets.
# NEVER put these in frontend code, .env files shipped to the
# browser, or commit them to git.
#
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#   supabase secrets set FIRMS_MAP_KEY=...
#   supabase secrets set AI_API_KEY=...
# ---------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Supabase project settings → API
FIRMS_MAP_KEY=your-nasa-firms-map-key              # https://firms.modaps.eosdis.nasa.gov/api/map_key/
AI_API_KEY=your-ai-provider-api-key                # e.g. an Anthropic API key

# NASA POWER requires no API key for the public daily-point endpoint,
# so no POWER-specific key is needed here.
